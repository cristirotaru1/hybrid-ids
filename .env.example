# Copy this file to .env and fill the deployment-specific and secret values.
LAB_HOST_IP=192.168.122.13
FLOODLIGHT_HOST=192.168.122.10
FLOODLIGHT_PORT=8080

SWITCH_NAME=lab-switch
SWITCH_DPID=0000005000000401
SWITCH_CIDR=10.10.0.0/24

# Keep true until an explicitly approved live Floodlight test.
REACT_DRY_RUN=true

RULES_FILE=test.rules
COOLDOWN_SECONDS=60
TOKEN_TTL_SECONDS=3600
EMAIL_ATTEMPTS=3
LOG_LEVEL=INFO

SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
EMAIL_FROM=replace-me@example.com
EMAIL_TO=replace-me@example.com
